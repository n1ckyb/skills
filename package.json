{
  "name": "skill-explorer",
  "version": "1.0.0",
  "description": "Community-ready standalone Copilot CLI extension and skill for discovering, security-vetting, and installing skills.",
  "type": "module",
  "main": "extensions/skill-explorer/extension.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n1ckyb/skills.git"
  },
  "homepage": "https://github.com/n1ckyb/skills#readme",
  "bugs": {
    "url": "https://github.com/n1ckyb/skills/issues"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check": "node --check extensions/skill-explorer/extension.mjs extensions/skill-explorer/skill-shortlist-canvas.mjs extensions/skill-explorer/lib/*.mjs scripts/skill-explorer-diagnostics.mjs",
    "diagnostics": "node scripts/skill-explorer-diagnostics.mjs",
    "diagnostics:prod": "node scripts/skill-explorer-diagnostics.mjs --prod",
    "diagnostics:dev": "node scripts/skill-explorer-diagnostics.mjs --dev",
    "diagnostics:test": "node scripts/skill-explorer-diagnostics.mjs --test",
    "contract:validate": "node --test --test-name-pattern=\"static contract\" tests/operation-response.test.mjs",
    "origin:validate": "node --test --test-name-pattern=\"origin\" tests/operation-response.test.mjs",
    "skill:validate": "node scripts/validate-skill.mjs",
    "plugin:validate": "node scripts/validate-plugin.mjs"
  },
  "keywords": [
    "copilot",
    "skill-explorer",
    "security",
    "extension",
    "skill"
  ],
  "author": "GitHub Copilot Community",
  "license": "MIT"
}
